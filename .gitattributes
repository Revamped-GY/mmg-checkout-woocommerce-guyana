# Default to LF on commit. Working copies on Windows can keep CRLF locally.
* text=auto eol=lf

# Force LF for source files regardless of host OS.
*.php       text eol=lf
*.js        text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.txt       text eol=lf
*.md        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.xml       text eol=lf
*.svg       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf
.env.example text eol=lf

# Force CRLF for Windows-only files.
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Treat binaries as such so git does not try to diff or convert them.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.zip       binary
*.gz        binary
*.tar       binary
*.pdf       binary
*.woff      binary
*.woff2     binary

# Files that should not appear in source archives generated by GitHub
# (release assets are produced by the workflow, not by GitHub's archive feature).
.github/        export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.env.example    export-ignore
tests/          export-ignore
docs/           export-ignore
AGENTS.md       export-ignore
CLAUDE.md       export-ignore
PRODUCT.md      export-ignore
CONTRIBUTING.md export-ignore
SECURITY.md     export-ignore
CHANGELOG.md    export-ignore
README.md       export-ignore
