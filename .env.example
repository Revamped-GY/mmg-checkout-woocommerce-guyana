# MMG Checkout for WooCommerce: example environment file
#
# This plugin does not read from a .env file at runtime. All sensitive values
# can be defined as PHP constants in wp-config.php instead, which keeps them
# out of the WordPress database. The names below are documented here so anyone
# setting up a development or production environment knows what is available.
#
# Copy this file to .env locally if your tooling expects one, then transfer
# the values into wp-config.php on the target site. Do not commit a .env file
# that contains real values.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------

# Mode the gateway runs in. sandbox or live.
MMGWC_MODE=sandbox

# Enable plugin debug logging.
MMGWC_DEBUG=false

# Log retention in days when debug is enabled (7, 14 or 30).
MMGWC_LOG_RETENTION_DAYS=14

# ---------------------------------------------------------------------------
# Sandbox (UAT) credentials. Provided by MMG Merchant Services.
# ---------------------------------------------------------------------------

MMGWC_SANDBOX_CHECKOUT_URL=https://mmgpg.mmgtest.net/mmg-pg/web/payments
MMGWC_SANDBOX_MERCHANT_ID=
MMGWC_SANDBOX_CLIENT_ID=
MMGWC_SANDBOX_MERCHANT_NAME=
MMGWC_SANDBOX_SECRET_KEY=
MMGWC_SANDBOX_PUBLIC_KEY=
MMGWC_SANDBOX_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Live (Production) credentials. Provided by MMG Merchant Services after UAT.
# ---------------------------------------------------------------------------

MMGWC_LIVE_CHECKOUT_URL=https://mmgpg.mymmg.gy/mmg-pg/web/payments
MMGWC_LIVE_MERCHANT_ID=
MMGWC_LIVE_CLIENT_ID=
MMGWC_LIVE_MERCHANT_NAME=
MMGWC_LIVE_SECRET_KEY=
MMGWC_LIVE_PUBLIC_KEY=
MMGWC_LIVE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Required: mode-specific Merchant Initiated API credentials.
# Transaction Lookup uses these credentials to verify every completed payment.
# The optional approval-request checkout also needs the credit account ID.
# ---------------------------------------------------------------------------

MMGWC_SANDBOX_MWALLET_BASE_URL=https://mwallet.mmgtest.net/olive/publisher/v1
MMGWC_SANDBOX_API_KEY=
MMGWC_SANDBOX_WSS_MID=
MMGWC_SANDBOX_WSS_MKEY=
MMGWC_SANDBOX_WSS_MSECRET=
MMGWC_SANDBOX_API_PASSWORD=
MMGWC_SANDBOX_API_CREDIT_ACCOUNT_ID=

# MMG must issue and approve the Live values. The public developer page only
# publishes the UAT base URL. Do not copy example credentials from the docs.
MMGWC_LIVE_MWALLET_BASE_URL=
MMGWC_LIVE_API_KEY=
MMGWC_LIVE_WSS_MID=
MMGWC_LIVE_WSS_MKEY=
MMGWC_LIVE_WSS_MSECRET=
MMGWC_LIVE_API_PASSWORD=
MMGWC_LIVE_API_CREDIT_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Currency conversion (only relevant for non-GYD stores).
# ---------------------------------------------------------------------------

MMGWC_ENABLE_CURRENCY_CONVERSION=no
MMGWC_FX_CACHE_HOURS=12

# ---------------------------------------------------------------------------
# Order status mapping. Leave blank to use the WooCommerce default for each.
# Success mappings must be paid statuses such as processing or completed.
# Failure mappings must be unpaid statuses such as on-hold, cancelled or failed.
# ---------------------------------------------------------------------------

MMGWC_STATUS_SUCCESS_VIRTUAL=
MMGWC_STATUS_SUCCESS_PHYSICAL=
MMGWC_STATUS_CANCELLED=cancelled
MMGWC_STATUS_FAILED=failed
MMGWC_STATUS_TIMEOUT=failed
